#    password: <your-password>
#    url: jdbc:mysql://<your-host>:<port>/<database>?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=UTC&useSSL=true
#    driver-class-name: com.mysql.cj.jdbc.Driver
#  hikari:
#    pool-name: Retail_HikariCP
#    minimum-idle: 15
#    idle-timeout: 180000
#    maximum-pool-size: 25
#    auto-commit: true
#    max-lifetime: 1800000
