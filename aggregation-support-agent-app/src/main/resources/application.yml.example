spring:
  config:
    name: aggregation-support-agent-app
  profiles:
    active: dev  # 可选: dev / test / prod
  # 优雅停机（D07）：等待在途请求完成再关闭
  lifecycle:
    timeout-per-shutdown-phase: 30s

server:
  shutdown: graceful

# CORS 允许的前端来源（SELFLOOP2 loop-207）：显式列表 + credentials，禁止 "*"
# base 默认本地回环；部署环境用环境变量 CORS_ALLOWED_ORIGINS 或 profile 覆盖
cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://127.0.0.1:3000,http://127.0.0.1:3001}

# 存活/就绪探针（D07）：/actuator/health/liveness 与 /readiness；仅暴露健康端点，不开放 metrics
management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      probes:
        enabled: true

# AIOps 工具结果溢出围栏（spill guard）—— 超限截断/围栏时在数据内留模型可见 [spill] 标记。
# 以下为默认值，可按部署在 profile 文件中覆盖：
# aiops:
#   spill:
#     max-chars: 6000              # 单次工具返回字符预算
#     max-alerts: 20               # 活动告警单次返回条数上限（totalAlerts 保留真实值）
#     max-timeseries-points: 120   # 单时间序列点数上限（等距降采样，保首尾）
#     max-log-entries: 50          # 日志单次返回条数上限（totalLogs 保留真实值，保留最近）

# springdoc-openapi（D06）：文档端点与分组（分组定义见 application-dev.yml）
# springdoc:
#   api-docs:
#     path: /v3/api-docs
#   swagger-ui:
#     path: /swagger-ui.html

# logging（AUTOLOOP al-41 / 工单 1041）：dev 环境 SQL 可见性建议段。
# 真实 application-dev.yml 为本地部署文件不入库（本仓约定，.gitignore:71），
# 本地 dev 请在 logging.level 下追加：
#   cn.chyuan.ai.infrastructure.persistent.mapper: debug
# 效果：SQL 语句+参数分两行输出（MyBatis 内建，零依赖）。
# 评估记录：P6Spy（jdbc:p6spy 前缀方案）因破坏 MYSQL_URL 环境变量契约弃用；
# 若后续需单行含参 SQL/慢 SQL 阈值，按 spy.properties 方案专题引入。
# logging:
#   level:
#     root: info
#     cn.chyuan.ai.infrastructure.persistent.mapper: debug

# Neo4j 连接生命周期（SELFLOOP2 loop-246）：安全默认已内置于代码，
# 以下为可选外置项（neo4j.enabled=true 时生效）：
# neo4j:
#   connection-timeout-seconds: 10          # TCP 连接建立超时
#   connection-acquisition-timeout-seconds: 30  # 池获取连接超时
#   max-connection-pool-size: 50            # 连接池上限
#   max-connection-lifetime-seconds: 3600   # 连接最长寿命
