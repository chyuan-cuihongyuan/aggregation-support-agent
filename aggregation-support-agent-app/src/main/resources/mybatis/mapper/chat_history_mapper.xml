<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.chyuan.ai.infrastructure.persistent.mapper.ChatHistoryMapper">

    <resultMap id="ChatHistoryMap" type="cn.chyuan.ai.infrastructure.dao.po.ChatHistoryPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="agent_id" property="agentId"/>
        <result column="agent_name" property="agentName"/>
        <result column="session_id" property="sessionId"/>
        <result column="question" property="question"/>
        <result column="answer" property="answer"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.chyuan.ai.infrastructure.dao.po.ChatHistoryPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_history (user_id, agent_id, agent_name, session_id, question, answer, create_time, update_time)
        VALUES (#{userId}, #{agentId}, #{agentName}, #{sessionId}, #{question}, #{answer}, #{createTime}, #{updateTime})
    </insert>

    <select id="queryByUserId" parameterType="java.lang.String" resultMap="ChatHistoryMap">
        SELECT id, user_id, agent_id, agent_name, session_id, question, answer, create_time, update_time
        FROM chat_history
        WHERE user_id = #{userId}
        ORDER BY create_time ASC
    </select>

    <delete id="deleteByUserId" parameterType="java.lang.String">
        DELETE FROM chat_history WHERE user_id = #{userId}
    </delete>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM chat_history WHERE id = #{id}
    </delete>

</mapper>
