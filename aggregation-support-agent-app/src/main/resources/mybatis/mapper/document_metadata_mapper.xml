<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.chyuan.ai.infrastructure.persistent.mapper.DocumentMetadataMapper">

    <resultMap id="DocumentMetadataMap" type="cn.chyuan.ai.infrastructure.dao.po.DocumentMetadataPO">
        <id column="id" property="id"/>
        <result column="document_id" property="documentId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_extension" property="fileExtension"/>
        <result column="file_size" property="fileSize"/>
        <result column="mime_type" property="mimeType"/>
        <result column="total_chars" property="totalChars"/>
        <result column="total_chunks" property="totalChunks"/>
        <result column="section_count" property="sectionCount"/>
        <result column="processing_status" property="processingStatus"/>
        <result column="error_message" property="errorMessage"/>
        <result column="user_id" property="userId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.chyuan.ai.infrastructure.dao.po.DocumentMetadataPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO document_metadata (document_id, file_name, file_extension, file_size, mime_type,
                                       total_chars, total_chunks, section_count, processing_status,
                                       error_message, user_id, create_time, update_time)
        VALUES (#{documentId}, #{fileName}, #{fileExtension}, #{fileSize}, #{mimeType},
                #{totalChars}, #{totalChunks}, #{sectionCount}, #{processingStatus},
                #{errorMessage}, #{userId}, #{createTime}, #{updateTime})
    </insert>

    <select id="queryByUserId" resultMap="DocumentMetadataMap">
        SELECT * FROM document_metadata
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="queryByDocumentId" resultMap="DocumentMetadataMap">
        SELECT * FROM document_metadata
        WHERE document_id = #{documentId}
    </select>

    <update id="updateStatus">
        UPDATE document_metadata
        SET processing_status = #{processingStatus},
            total_chunks      = #{totalChunks},
            total_chars       = #{totalChars},
            section_count     = #{sectionCount},
            error_message     = #{errorMessage},
            update_time       = NOW()
        WHERE document_id = #{documentId}
    </update>

    <delete id="deleteByDocumentId">
        DELETE FROM document_metadata
        WHERE document_id = #{documentId}
    </delete>

</mapper>
